PORT=8000
NODE_ENV=production

# Custom 8-character pairing code (must be A-Z0-9). Leave empty for random.
PAIRING_CODE=XADONITE

# Optional: JSON list of extra newsletter JIDs to auto-follow
# CHANNELS_URL=https://example.com/channels.json

# ── GitHub OAuth (recommended) ──────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://YOUR-APP.onrender.com/auth/github/callback

# ── Google OAuth (alternative) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-APP.onrender.com/auth/google/callback

# ── Admin ───────────────────────────────────────────────────
ADMIN_EMAILS=musteqeemowoseni@gmail.com
ADMIN_KEY=unknown#1@0123#234
